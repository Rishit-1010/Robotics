055\055\055\055\055 SETUP \055\055\055\055\055\055\055\055\055\055\015\n\015\nvoid setup\050\051 \173\015\n  pinMode\050button\054 INPUT\137PULLUP\051\073\015\n  pinMode\050buzzer\054 OUTPUT\051\073\015\n\015\n  Serial\056begin\0509600\051\073\015\n\015\n  pencil\056attach\050servoPin\051\073\015\n  pencil\056write\050UP\051\073\015\n\015\n  Serial\056println\050\042Ready\042\051\073\015\n  Serial\056println\050\042Button\072 Morse to English\042\051\073\015\n  Serial\056println\050\042Serial Monitor\072 English to Morse\042\051\073\015\n  Serial\056println\050\051\073\015\n\175\015\n\015\n\057\057 \055\055\055\055\055\055\055\055\055\055 MAIN LOOP \055\055\055\055\055\055\055\055\055\055\015\n\015\nvoid loop\050\051 \173\015\n  readButton\050\051\073\015\n  translateMorse\050\051\073\015\n  readSerial\050\051\073\015\n\175\015\n\015\n\057\057 \055\055\055\055\055\055\055\055\055\055 BUTTON\072 MORSE TO ENGLISH \055\055\055\055\055\055\055\055\055\055\015\n\015\nvoid readButton\050\051 \173\015\n  bool pressed \075 digitalRead\050button\051 \075\075 LOW\073\015\n\015\n  \057\057 Button has just been pressed\015\n  if \050pressed \046\046 \041buttonWasPressed\051 \173\015\n    pressStart \075 millis\050\051\073\015\n    buttonWasPressed \075 true\073\015\n  \175\015\n\015\n  \057\057 Button has just been released\015\n  if \050\041pressed \046\046 buttonWasPressed\051 \173\015\n    int pressTime \075 millis\050\051 \055 pressStart\073\015\n\015\n    \057\057 Short press \075 dot\015\n    if \050pressTime \074 300\051 \173\015\n      morse \053\075 \042\056\042\073\015\n      beep\050DOT\137TIME\051\073\015\n    \175\015\n\015\n    \057\057 Long press \075 dash\015\n    else \173\015\n      morse \053\075 \042\055\042\073\015\n      beep\050DASH\137TIME\051\073\015\n    \175\015\n\015\n    lastRelease \075 millis\050\051\073\015\n    buttonWasPressed \075 false\073\015\n  \175\015\n\175\015\n\015\n\057\057 \055\055\055\055\055\055\055\055\055\055 TRANSLATE MORSE TO ENGLISH \055\055\055\055\055\055\055\055\055\055\015\n\015\nvoid translateMorse\050\051 \173\015\n  if \050morse \041\075 \042\042 \046\046 \041buttonWasPressed\051 \173\015\n    int pauseTime \075 millis\050\051 \055 lastRelease\073\015\n\015\n    \057\057 Pause between 1 and 2\0565 seconds \075 end of letter\015\n    if \050pauseTime \076 1000 \046\046 pauseTime \074 2500\051 \173\015\n      Serial\056print\050morse\051\073\015\n      Serial\056print\050\042 \075 \042\051\073\015\n      Serial\056println\050findEnglish\050morse\051\051\073\015\n\015\n      morse \075 \042\042\073\015\n    \175\015\n\015\n    \057\057 Pause of 2\0565 seconds or more \075 end of word\015\n    if \050pauseTime \076\075 2500\051 \173\015\n      Serial\056print\050morse\051\073\015\n      Serial\056print\050\042 \075 \042\051\073\015\n      Serial\056println\050findEnglish\050morse\051\051\073\015\n\015\n      Serial\056println\050\042WORD SPACE\042\051\073\015\n\015\n      morse \075 \042\042\073\015\n    \175\015\n  \175\015\n\175\015\n\015\n\057\057 \055\055\055\055\055\055\055\055\055\055 FIND ENGLISH LETTER \055\055\055\055\055\055\055\055\055\055\015\n\015\nchar findEnglish\050String pattern\051 \173\015\n  for \050int i \075 0\073 i \074 26\073 i\053\053\051 \173\015\n    if \050code\133i\135 \075\075 pattern\051 \173\015\n      return \047A\047 \053 i\073\015\n    \175\015\n  \175\015\n\015\n  return \047\077\047\073\015\n\175\015\n\015\n\057\057 \055\055\055\055\055\055\055\055\055\055 SERIAL MONITOR\072 ENGLISH TO MORSE \055\055\055\055\055\055\055\055\055\055\015\n\015\nvoid readSerial\050\051 \173\015\n  while \050Serial\056available\050\051\051 \173\015\n    char letter \075 Serial\056read\050\051\073\015\n\015\n    \057\057 Ignore Enter key characters\015\n    if \050letter \075\075 \047\134n\047 \174\174 letter \075\075 \047\134r\047\051 \173\015\n      continue\073\015\n    \175\015\n\015\n    \057\057 Convert lowercase letters to uppercase\015\n    if \050letter \076\075